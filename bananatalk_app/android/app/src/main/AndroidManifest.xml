<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.bananatalk.app">

    <!-- ==================== INTERNET & NETWORK ==================== -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>

    <!-- ==================== LOCATION PERMISSIONS ==================== -->
    <!-- Only foreground location needed for: nearby users, chat location sharing, profile -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Explicitly REMOVE background location - we don't need it -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:node="remove" />

    <!-- ==================== CAMERA & AUDIO PERMISSIONS ==================== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Camera & Mic Hardware Features (optional - app works without them) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- We never place carrier calls: calls are in-app (LiveKit + CallKit/ConnectionService).
         Without this, any telephony permission implies a REQUIRED telephony feature and
         Google Play hides the app from Wi-Fi-only tablets (e.g. Galaxy Tab S7 FE SM-T733). -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- uCrop's activity is portrait-only, which otherwise implies a REQUIRED
         android.hardware.screen.portrait and hides the app from landscape-only devices.
         The app itself locks no orientation, so portrait is not a requirement. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!-- The Bluetooth, location and Wi-Fi permissions below each imply a REQUIRED
         hardware feature, which hides the app from devices without it (some
         Chromebooks, TVs, location-less tablets). All three are optional here:
         headsets, nearby/location sharing and Wi-Fi locks degrade gracefully. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- ==================== BLUETOOTH PERMISSIONS ==================== -->
    <!-- Legacy Bluetooth (headset routing on API <= 30); BLUETOOTH_CONNECT replaces them on 31+. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- ==================== FOREGROUND SERVICE PERMISSIONS ==================== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: a call keeps the mic (and camera for video) alive in the
         background only inside a typed foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- ==================== WAKE & VIBRATE ==================== -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ==================== STORAGE PERMISSIONS ==================== -->
    <!-- Android 12 and below -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 13+: no READ_MEDIA_* — image_picker uses the system photo picker and
         file_picker uses SAF, neither needs them (and Play's Photo & Video policy
         restricts them to apps whose core function is media access). -->

    <!-- ==================== NOTIFICATION PERMISSIONS ==================== -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ==================== PHONE/CALL PERMISSIONS ==================== -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- No READ_CONTACTS, READ_PHONE_STATE, SYSTEM_ALERT_WINDOW or
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: nothing in lib/ asks for them and no
         plugin path the app uses needs them (calls are self-managed, the foreground
         service runs without an overlay or a battery exemption).
         test/android/android_release_config_test.dart keeps them out. -->

    <!-- flutter_callkit_incoming guards its exported incoming-call activity, receiver
         and service with this permission at protectionLevel="normal", which any
         installed app can hold (fake full-screen "incoming call", spoofed
         accept/decline). Its own intents are explicit and sent by this app, so
         "signature" keeps them working and shuts everyone else out. -->
    <permission
        android:name="${applicationId}.PERMISSION_CALL"
        android:protectionLevel="signature"
        tools:replace="android:protectionLevel" />

    <!-- ==================== BILLING PERMISSION (Google Play In-App Purchases) ==================== -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- A plugin merges this literal, invalid name (not a real permission).
         Harmless, but Play's pre-launch report flags it. -->
    <uses-permission android:name="Manifest.permission.CAPTURE_AUDIO_OUTPUT" tools:node="remove" />

    <application
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:label="Bananatalk"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:turnScreenOn="true"
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Android App Links: https://banatalk.com, only the paths
                 lib/services/deep_link_parser.dart routes. Once assetlinks.json
                 verifies, anything matched here opens the app, so the legal
                 pages (/privacy-policy, /terms-of-use) and the rest of the site
                 must stay out and keep opening in the browser.
                 test/android/android_release_config_test.dart keeps the two in sync. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="banatalk.com" />
                <data android:pathPrefix="/moment/" />
                <data android:pathPrefix="/profile/" />
                <data android:pathPrefix="/community/" />
                <data android:pathPrefix="/i/" />
            </intent-filter>

            <!-- Custom scheme: bananatalk:// -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bananatalk" />
            </intent-filter>
        </activity>

        <!-- Flutter metadata -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Google AdMob App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5669092242437690~7322694079"/>

        <!-- FCM Notification Configuration -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- geolocator ships its service with android:foregroundServiceType="location".
             On Android 14+ that type obliges the app to hold FOREGROUND_SERVICE_LOCATION
             at the moment startForeground() runs, and we do not declare it.

             We never take location into the foreground: startForeground() is reachable
             only through enableBackgroundMode(), which StreamHandlerImpl calls only when
             Dart passes foregroundNotificationConfig to getPositionStream — and nothing
             in lib/ does. The plugin still binds this service unconditionally
             (GeolocatorPlugin.bindService), so the declaration has to stay; only the
             unused type goes. That avoids declaring a foreground-service permission we
             do not use, which Google Play would require us to justify at submission.

             If foreground location is ever wanted, this removal must go, and
             FOREGROUND_SERVICE_LOCATION must be declared and justified in Play Console. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:remove="android:foregroundServiceType" />

        <!-- flutter_foreground_task: ongoing-call service (lib/services/call/call_foreground_service.dart).
             stopWithTask: swiping the app away ends the call's engine, so the service
             must go too (otherwise onTaskRemoved schedules a restart and START_STICKY
             keeps "Call in progress" up with no call). Do not use the plugin's Dart
             stopWithTask option instead: that stops the service on Home. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="microphone|camera"
            android:stopWithTask="true"
            android:exported="false" />
        <!-- The plugin's boot receiver only serves autoRunOnBoot, which a call never
             uses; drop the exported receiver. (RECEIVE_BOOT_COMPLETED stays: WorkManager.) -->
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RebootReceiver"
            tools:node="remove" />

        <!-- image_cropper (uCrop) — required on Android; plugin manifest no longer merges this automatically. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

    </application>
</manifest>