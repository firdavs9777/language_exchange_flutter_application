<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Bananatalk</string>
    <!-- Must be a channel the app creates (NotificationService creates
         high_importance_channel): FCM posts background/killed pushes whose
         channel is missing here, so a nonexistent id sent them all to
         "Miscellaneous" with no heads-up. -->
    <string name="default_notification_channel_id">high_importance_channel</string>
    <string name="default_notification_channel_name">Bananatalk Notifications</string>
    
    <!-- Facebook SDK Configuration -->
    <!-- Replace these with your actual Facebook App ID and Client Token from https://developers.facebook.com/ -->
    <string name="facebook_app_id">YOUR_FACEBOOK_APP_ID</string>
    <string name="facebook_client_token">YOUR_FACEBOOK_CLIENT_TOKEN</string>
    <string name="fb_login_protocol_scheme">fbYOUR_FACEBOOK_APP_ID</string>
</resources>
