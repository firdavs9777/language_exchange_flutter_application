<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup, Android 6-11 (android:fullBackupContent). A restored or new
     device must sign in again: the session (token, refreshToken in
     shared_preferences) and the biometric secure storage (whose Keystore
     master key never leaves the device, so a copy cannot be decrypted) are
     not backed up. Keep in sync with data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
