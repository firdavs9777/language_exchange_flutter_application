REACT_APP_API_URL=https://api.banatalk.com
REACT_APP_GIPHY_API_KEY=aXnrm8WZXykwuK8EZGx7LBOKuqOlwJHX
GENERATE_SOURCEMAP=false

# GA4 measurement id (G-XXXXXXXXXX). Empty = GA disabled. Loaded only after consent.
REACT_APP_GA_MEASUREMENT_ID=

# Google AdSense (same publisher account as AdMob). Manual placements stay
# empty until their slot ids exist in the AdSense console; Auto ads need only
# the client id and are switched on per site in the console.
REACT_APP_ADSENSE_CLIENT=ca-pub-5669092242437690
REACT_APP_ADSENSE_AUTO_ADS=true

# Sign in with Apple on the website: the Services ID (owner creates it in
# Phase 5, grouped with com.bananatalk.bananatalkApp, return URL
# https://banatalk.com/login). Empty = the Apple button stays hidden even
# when /app-config says webAppleSigninEnabled.
REACT_APP_APPLE_SERVICES_ID=com.bananatalk.com
